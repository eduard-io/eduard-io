---
interface Props {
  href: string;
  primary?: boolean;
  label?: string;
}
const { href, primary = false, label } = Astro.props;
---

<a class:list={['button', { primary }]} href={href} aria-label={label}>
  <slot />
  <img src={`/images/v4/arrow-${primary ? 'light' : 'dark'}.svg`} width="24" height="24" alt="" />
</a>
<style>
  .button {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-1);
    padding: 3.5px 7.5px 3.5px 15.5px;
    border: 0.5px solid var(--foreground);
    border-radius: 999px;
    color: var(--foreground);
    font-weight: 600;
    line-height: 28px;
    text-decoration: none;
  }
  .primary {
    background: var(--foreground);
    color: var(--background);
  }
  .button:hover {
    background: var(--surface);
  }
  .primary:hover {
    background: var(--foreground-hover);
  }
  img {
    flex: none;
    transition: transform 100ms ease-out;
  }
  .button:hover img {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    img {
      transition: none;
    }
  }
</style>
