---
import ContactButton from './ContactButton.astro';
import { site, emailLink } from '../data/site';
---

<section class="intro narrow" aria-labelledby="intro-title">
  <h1 id="intro-title">
    I’m Eduard,<br />an engineer turned <span class="designer"
      >designer<picture aria-hidden="true">
        <source media="(min-width: 1100px)" srcset="/images/v4/underline-desktop.svg" />
        <source media="(min-width: 700px)" srcset="/images/v4/underline-tablet.svg" />
        <img src="/images/v4/underline-mobile.svg" alt="" />
      </picture></span
    >
  </h1>
  <p>{site.description}</p>
  <ContactButton href={emailLink('Hello Eduard!')} primary>Get in touch</ContactButton>
</section>
<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }
  h1 {
    font-weight: 900;
    font-size: var(--display-size);
    line-height: var(--display-line);
    letter-spacing: -0.75px;
  }
  .designer {
    isolation: isolate;
    position: relative;
    white-space: nowrap;
  }
  picture {
    position: absolute;
    z-index: -1;
    left: 0;
    bottom: -10px;
    pointer-events: none;
    transform: rotate(5.61deg);
  }
  picture img {
    max-width: none;
  }
  p {
    font-size: 21px;
    line-height: 32px;
    color: #454545;
  }
  @media (min-width: 700px) {
    p {
      max-width: 642px;
    }
  }
  @media (min-width: 1100px) {
    h1 {
      width: 793px;
      max-width: calc(100vw - 128px);
    }
    p {
      max-width: none;
    }
  }
</style>
